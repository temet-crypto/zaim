FROM rust:1.82-slim-bookworm AS builder
RUN apt-get update && apt-get install -y git protobuf-compiler pkg-config libssl-dev libsqlite3-dev autoconf automake libtool make gcc && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/zingolabs/zingolib.git /build && cd /build && git checkout zingolib_v3.0.0
WORKDIR /build
RUN cargo build --release --package zingo-cli
RUN ls -la /build/target/release/zingo-cli

FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y libssl3 libsqlite3-0 && rm -rf /var/lib/apt/lists/*
COPY --from=builder /build/target/release/zingo-cli /app/zingo-cli
RUN chmod +x /app/zingo-cli
COPY api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY api/ ./api/
RUN mkdir -p /app/wallets
ENV ZECWALLET_CLI=/app/zingo-cli
ENV WALLET_DIR=/app/wallets
ENV LIGHTWALLETD_SERVER=https://lwdv3.zecwallet.co:443
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
