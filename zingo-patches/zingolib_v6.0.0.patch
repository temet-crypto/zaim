+    if let Ok(list) = std::env::var("ZINGO_DESTINATIONS") {
+        let pool: Vec<Uri> = list
+            .split(',')
+            .filter_map(|entry| entry.trim().parse().ok())
+            .collect();
+        if pool.is_empty() {
+            return Err(NoEligibleDestinations::EmptyPool);
+        }
+        return Ok(pool);
+    }
